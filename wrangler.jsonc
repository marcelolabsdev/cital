{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cital",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cital",
      "database_id": "c89acbe8-8bf5-45bf-9497-8996853ba085",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a0d8083b8d7d42929462ba33a3a0e2d0"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
